{
    "[git-commit]": {
        "editor.rulers": [
            50,
            72
        ]
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "editor.formatOnSave": true,
        "editor.rulers": [
            80
        ]
    },
    "[rust]": {
        "editor.formatOnSave": true,
        "editor.rulers": [
            80
        ]
    },
    "chat.agent.codeBlockProgress": false,
    "chat.tools.terminal.autoApprove": {
        "docker run": true,
        "uv": true
    },
    "cSpell.language": "en-GB",
    "diffEditor.codeLens": true,
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": false,
    "editor.cursorWidth": 4,
    "editor.folding": false,
    "editor.fontFamily": "FiraCode Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontSize": 12,
    "editor.inlineSuggest.edits.showCollapsed": true,
    "editor.inlineSuggest.enabled": true,
    "editor.lineHeight": 0,
    "editor.minimap.enabled": false,
    "editor.mouseWheelScrollSensitivity": 2,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [
        100
    ],
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "*.mutable": {
                "underline": false
            }
        }
    },
    "editor.smoothScrolling": true,
    "editor.stickyScroll.enabled": false,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "string.quoted.docstring.multi.python",
                "settings": {
                    "foreground": "#6A9955"
                }
            },
            {
                "scope": "string.quoted.docstring.raw.multi.python",
                "settings": {
                    "foreground": "#6A9955"
                }
            },
            {
                "scope": "punctuation.definition.interpolation.just",
                "settings": {
                    "foreground": "#ff0000"
                }
            }
        ]
    },
    "editor.unicodeHighlight.includeStrings": false,
    "editor.wordWrap": "off",
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "{.in,.out}": "shellscript",
        "*.env.*": "shellscript",
        "*.mdx": "markdown",
        "*.plist": "xml",
        "*.sls": "yaml",
        "*.tac": "python",
        "Dockerfile.*": "dockerfile"
    },
    "files.exclude": {
        ".*_cache": true,
        ".coverage*": true,
        ".python-version": true,
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/*.pyc": true,
        "target": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.editorDecoration.template": "${authorName}, ${authorDateAgo} • ${subject}",
    "git.blame.statusBarItem.enabled": true,
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.enable": {
        "*": true,
        "markdown": false,
        "plaintext": true,
        "scminput": false
    },
    "go.toolsEnvVars": {
        "GO111MODULE": "on"
    },
    "go.toolsManagement.autoUpdate": true,
    "gopls": {
        "ui.navigation.importShortcut": "Definition"
    },
    "keyboard.dispatch": "keyCode",
    "markdown.extension.toc.levels": "2..6",
    "markdown.preview.scrollEditorWithPreview": false,
    "markdown.preview.scrollPreviewWithEditor": false,
    "python.analysis.addImport.exactMatchOnly": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.languageServer": "Pylance",
    "python.terminal.activateEnvironment": false,
    "python.testing.pytestEnabled": true,
    "remote.autoForwardPortsSource": "hybrid",
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.completion.snippets.custom": {
        "Mutex::arc": {
            "body": [
                "Arc::new(Mutex::new(${receiver}))"
            ],
            "postfix": "mutex",
            "requires": [
                "std::sync::Arc",
                "std::sync::Mutex"
            ],
            "scope": "expr"
        }
    },
    "rust-analyzer.diagnostics.experimental.enable": true,
    "rust-analyzer.imports.granularity.group": "item",
    "search.quickOpen.includeHistory": false,
    "security.workspace.trust.enabled": false,
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.env.osx": {
        "EDITOR": "code --wait",
        "GIT_EDITOR": "code --wait"
    },
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.mouseWheelScrollSensitivity": 2,
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.shellIntegration.history": 0,
    "terminal.integrated.shellIntegration.showCommandGuide": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.colorCustomizations": {
        "editorInlayHint.background": "#1e1e1e",
        "editorInlayHint.foreground": "#6a6a6a",
        "terminal.ansiBlue": "#569cd6",
        "terminal.background": "#1d1d1d"
    },
    "workbench.colorTheme": "Dark+",
    "workbench.editor.languageDetection": false,
    "workbench.editorAssociations": {
        "git-rebase-todo": "default"
    },
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "readme"
}
