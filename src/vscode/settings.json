{
    "[git-commit]": {
        "editor.rulers": [
            50,
            72
        ]
    },
    "[go]": {
        "editor.tabSize": 4
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
        // "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        // "editor.formatOnSave": true,
        "editor.insertSpaces": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        // "editor.formatOnSave": true,
        "editor.insertSpaces": true
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "editor.formatOnSave": true,
        "editor.rulers": [
            80
        ]
    },
    "[python]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true
    },
    "[rust]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.rulers": [
            80
        ],
        "editor.tabSize": 4
    },
    "[sql]": {
        "editor.defaultFormatter": "adpyke.vscode-sql-formatter"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "cSpell.language": "en-GB",
    "diffEditor.codeLens": true,
    "editor.accessibilitySupport": "off",
    "editor.cursorWidth": 4,
    "editor.folding": true,
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.formatOnType": true,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontSize": 10,
    "editor.inlineSuggest.enabled": true,
    "editor.language.colorizedBracketPairs": [],
    "editor.lineHeight": 0,
    "editor.minimap.enabled": false,
    "editor.mouseWheelScrollSensitivity": 2,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [
        100
    ],
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "*.mutable": {
                "underline": false
            }
        }
    },
    "editor.smoothScrolling": true,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "string.quoted.docstring.multi.python",
                "settings": {
                    "foreground": "#6A9955"
                }
            },
            {
                "scope": "punctuation.definition.interpolation.just",
                "settings": {
                    "foreground": "#ff0000"
                }
            }
        ]
    },
    "editor.unicodeHighlight.includeStrings": false,
    "editor.wordWrap": "off",
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "{.in,.out}": "shellscript",
        "*.env.*": "shellscript",
        "*.mdx": "markdown",
        "*.plist": "xml",
        "Dockerfile.*": "dockerfile"
    },
    "files.exclude": {
        ".*_cache": true,
        ".coverage*": true,
        ".python-version": true,
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/*.pyc": true,
        "target": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "scminput": false
    },
    "gitlens.advanced.messages": {
        "suppressLineUncommittedWarning": true
    },
    "gitlens.codeLens.enabled": false,
    "go.toolsEnvVars": {
        "GO111MODULE": "on"
    },
    "go.toolsManagement.autoUpdate": true,
    "gopls": {
        "ui.navigation.importShortcut": "Definition"
    },
    "keyboard.dispatch": "keyCode",
    "markdown.extension.toc.levels": "2..6",
    "markdown.preview.scrollEditorWithPreview": false,
    "markdown.preview.scrollPreviewWithEditor": false,
    "python.analysis.addImport.exactMatchOnly": true,
    "python.languageServer": "Pylance",
    "python.terminal.activateEnvironment": false,
    "python.testing.pytestEnabled": true,
    "redhat.telemetry.enabled": false,
    "rust-analyzer.completion.snippets.custom": {
        "Mutex::arc": {
            "body": [
                "Arc::new(Mutex::new(${receiver}))"
            ],
            "postfix": "mutex",
            "requires": [
                "std::sync::Arc",
                "std::sync::Mutex"
            ],
            "scope": "expr"
        }
    },
    "rust-analyzer.diagnostics.experimental.enable": true,
    "rust-analyzer.imports.granularity.group": "item",
    "rust-analyzer.inlayHints.parameterHints.enable": false,
    "rust-analyzer.server.extraEnv": {
        "CARGO_TARGET_DIR": "target/rust-analyzer"
    },
    "search.quickOpen.includeHistory": false,
    "security.workspace.trust.enabled": false,
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.env.osx": {
        "EDITOR": "code --wait",
        "GIT_EDITOR": "code --wait"
    },
    "terminal.integrated.fontFamily": "Fira Code",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.mouseWheelScrollSensitivity": 2,
    "workbench.colorCustomizations": {
        "editorInlayHint.background": "#1e1e1e",
        "editorInlayHint.foreground": "#6a6a6a",
        "terminal.ansiBlue": "#569cd6",
        "terminal.background": "#1d1d1d"
    },
    "workbench.editor.languageDetection": false,
    "workbench.editorAssociations": {
        "git-rebase-todo": "default"
    },
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "readme"
}
