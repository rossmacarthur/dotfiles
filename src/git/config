[alias]
	lg = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --no-show-signature
	lgr = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --no-show-signature --reverse
	lgnb = log --pretty=format:'%Cred%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --no-show-signature
	lgnbr = log --pretty=format:'%Cred%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --no-show-signature --reverse

[core]
	editor = vim
	excludesfile = ~/.config/git/ignore

[diff]
	tool = codediff

[difftool "vscode"]
	cmd = code -n --wait --diff $LOCAL $REMOTE

[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff --exit-on-close file $LOCAL $REMOTE\"

[fetch]
	prune = true

[init]
	defaultBranch = trunk

[log]
	showSignature = true

[merge]
	tool = codediff

[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"

[pull]
	ff = only

