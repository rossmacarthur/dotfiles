#!/usr/bin/env zsh

source "${${(%):-%x}:A:h}/plugins/evalcache.plugin.zsh"

# Add a directory to the PATH environment variable.
path_push() {
    if [ ! -d "$1" ]; then return; fi
    PATH=${PATH//":$1:"/":"} # delete any instances in the middle
    PATH=${PATH/#"$1:"/} # delete any instance at the beginning
    PATH=${PATH/%":$1"/} # delete any instance in the at the end
    PATH=$1:$PATH # prepend
}

# Default directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

if [[ "$OSTYPE" == darwin* ]]; then
    export LANG=${LANG:-en_US.UTF-8}
fi

if [[ -f /opt/homebrew/bin/brew ]]; then
    evalcache /opt/homebrew/bin/brew shellenv zsh
    path=("${(@u)path}")
    fpath=("${(@u)fpath}")
fi

# Default editor
if [ -z "${EDITOR+x}" ]; then
    for editor in nvim vim vi; do
        if (( $+commands[$editor] )); then
            export EDITOR=$editor
            break
        fi
    done
fi

# Go env
export GO111MODULE=on
export GOPATH="$HOME/.go"

# Python env
export UV_PYTHON_PREFERENCE=only-managed

# Docker env
export DOCKER_CLI_HINTS=false

# Extra paths
path_push "$HOME/.local/bin"
path_push "$HOME/.cargo/bin"
path_push "$GOPATH/bin"
path_push "${MISE_DATA_DIR:-$XDG_DATA_HOME/mise}/shims"

# Source all the things ✨
evalcache sheldon source
