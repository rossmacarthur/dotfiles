// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // UI
  "buffer_font_family": "Fira Code",
  "ui_font_family": "Fira Code",
  "scroll_sensitivity": 2.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "chat_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "notification_panel": {
    "dock": "right"
  },
  "terminal": {
    "dock": "right",
    "default_width": 1000,
    "cursor_shape": "underline",
    "env": {
      "EDITOR": "zed --wait",
      "GIT_EDITOR": "zed --wait"
    },
    "font_size": 14.0,
    "font_family": "Fira Code"
  },
  "debugger": {
    "dock": "right"
  },
  "minimap": { "show": "auto" },
  "resize_all_panels_in_dock": ["right"],

  // Editing
  "edit_predictions": {
    "mode": "eager"
  },
  "file_types": {
    "dockerfile": ["Dockerfile.*"],
    "markdown": ["*.mdx"],
    "nginx": ["*.conf"],
    "shellscript": ["*.env.*", "{.in,.out}"],
    "xml": ["*.plist"]
  },
  "languages": {
    "Git Commit": {
      "preferred_line_length": 72,
      "wrap_guides": [50, 72]
    },
    "Go": {
      "format_on_save": "on",
      "preferred_line_length": 100,
      "wrap_guides": [100]
    },
    "Markdown": {
      "preferred_line_length": 80,
      "wrap_guides": [80]
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        {
          "language_server": { "name": "ruff" }
        }
      ]
    },
    "Rust": {
      "preferred_line_length": 100,
      "wrap_guides": [80, 100]
    },
    "TOML": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "granularity": {
            "group": "item"
          }
        },
        "completion": {
          "postfix": { "enable": true }
        }
      }
    }
  },
  "agent": {
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4"
    }
  },
  "features": {
    "edit_prediction_provider": "copilot"
  }
}
